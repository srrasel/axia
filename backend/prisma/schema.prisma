generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MANAGER
  EMPLOYEE
  TEAM_LEADER
  SALES
  RETENTION
  COMPLIANCE
  FINANCE
  SUPPORT
  MARKETING
}

enum AccountType {
  demo
  live
}

enum TradeSide {
  buy
  sell
}

enum TradeStatus {
  open
  pending
  closed
}

enum TradeSource {
  self
  social
}

enum AssetCategory {
  forex
  crypto
  commodity
  stock
  index
}

enum TxType {
  deposit
  withdraw
  trade_pnl
  credit
  debit
  fee
  commission
  bonus
}

enum TxStatus {
  pending
  approved
  rejected
  completed
}

enum KycStatus {
  none
  pending
  approved
  rejected
}

enum CrmCategory {
  BAD
  CONVERSION
  FTD
  NEW
  ONLINE
  ONLINE_FTD
  POTENTIAL
  PRACTICE
  RETENTION
  TEST
}

enum CrmClientStatus {
  NEW
  ACTIVE
  INACTIVE
  POTENTIAL
  BAD
  RETENTION
  BLOCKED
}

enum EarningType {
  trading_fee
  deposit_fee
  withdraw_fee
  spread
  swap
  referral_commission
  other
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  passwordHash       String
  name               String
  initials           String
  phone              String?
  /// Profile photo as data URL (image/jpeg|png|webp)
  photoUrl           String?
  nationality        String          @default("Saudi Arabia")
  country            String          @default("Saudi Arabia")
  language           String          @default("en")
  role               Role            @default(USER)
  verified           Boolean         @default(false)
  funded             Boolean         @default(false)
  totalDeposited     Float           @default(0)
  questionnaireDone  Boolean         @default(false)
  referralCode       String          @unique
  referredById       String?
  referredBy         User?           @relation("Referrals", fields: [referredById], references: [id])
  referrals          User[]          @relation("Referrals")
  assignedToId       String?
  assignedTo         User?           @relation("ClientAssignment", fields: [assignedToId], references: [id])
  assignedClients    User[]          @relation("ClientAssignment")
  lastSeenAt         DateTime?
  lastInteractionAt  DateTime?
  kycStatus          KycStatus       @default(none)
  emailVerified      Boolean         @default(false)
  phoneVerified      Boolean         @default(false)
  addressVerified    Boolean         @default(false)
  identityVerified   Boolean         @default(false)
  amlStatus          KycStatus       @default(none)
  tradingRestricted  Boolean         @default(false)
  active             Boolean         @default(true)
  crmNumber          Int?            @unique
  crmCategory        CrmCategory     @default(NEW)
  crmStatus          CrmClientStatus @default(NEW)
  clientSource       String?
  /// Marketing attribution
  campaign           String?
  campaignId         String?
  campaignType       String?
  mediaSource        String?
  adGroup            String?
  creative           String?
  keyword            String?
  landingPage        String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?
  clickId            String?
  address            String?
  dateOfBirth        String?
  totpEnabled        Boolean         @default(false)
  totpSecret         String?
  totpTempSecret     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  accounts           Account[]
  trades             Trade[]
  transactions       Transaction[]
  notifications      Notification[]
  kycDocuments       KycDocument[]
  supportMessages    SupportMessage[]
  earnings           PlatformEarning[]
  contactsAsClient   ContactLog[]    @relation("ContactClient")
  contactsAsStaff    ContactLog[]    @relation("ContactStaff")
  priceOverrides     PriceOverride[]
  crmComments        CrmComment[]    @relation("CrmCommentClient")
  crmCommentsAuthored CrmComment[]   @relation("CrmCommentStaff")
  crmActivities      CrmActivity[]   @relation("CrmActivityClient")
  crmActivitiesAuthored CrmActivity[] @relation("CrmActivityStaff")
  staffNotifications StaffNotification[] @relation("StaffNotifRecipient")
  loginLogs          LoginLog[]
  staffSessions      StaffSession[]
  /// Override default role permissions (JSON string array of permission keys)
  permissionsJson    String?

  @@index([role])
  @@index([lastSeenAt])
  @@index([assignedToId])
  @@index([crmCategory])
  @@index([crmStatus])
  @@index([country])
  @@index([clientSource])
}

model Account {
  id           String        @id @default(cuid())
  number       String        @unique
  type         AccountType
  platform     String        @default("MT5")
  leverage     String        @default("1:400")
  currency     String        @default("USD")
  balance      Float         @default(0)
  equity       Float         @default(0)
  credit       Float         @default(0)
  active       Boolean       @default(true)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades       Trade[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
}

model Trade {
  id           String        @id @default(cuid())
  symbol       String
  side         TradeSide
  volume       Float
  openPrice    Float
  currentPrice Float
  closePrice   Float?
  openTime     DateTime      @default(now())
  closeTime    DateTime?
  status       TradeStatus   @default(open)
  stopLoss     Float?
  takeProfit   Float?
  triggerPrice Float?
  realizedPnl  Float?
  commission   Float         @default(0)
  swap         Float         @default(0)
  /// When true, market tick will not overwrite currentPrice (admin forced mark)
  markLocked   Boolean       @default(false)
  category     AssetCategory
  source       TradeSource   @default(self)
  userId       String
  accountId    String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId, accountId, status])
}

model Transaction {
  id         String   @id @default(cuid())
  type       TxType
  status     TxStatus @default(completed)
  amount     Float
  fee        Float    @default(0)
  payment    String
  note       String?
  gatewayRef String?
  meta       String?
  userId     String
  accountId  String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([gatewayRef])
}

model PlatformEarning {
  id          String      @id @default(cuid())
  type        EarningType
  amount      Float
  currency    String      @default("USD")
  description String
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  meta        String?
  createdAt   DateTime    @default(now())

  @@index([type])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  read      Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model KycDocument {
  id        String    @id @default(cuid())
  kind      String
  docType   String
  fileName  String
  mimeType  String?
  fileData  String?
  status    KycStatus @default(pending)
  note      String?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

/** Member support messages submitted from the floating support form */
model SupportMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String   @default("Support")
  message   String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/** CRM: forced market quotes for a symbol (manager price control) */
model PriceOverride {
  id          String   @id @default(cuid())
  symbol      String   @unique
  price       Float
  bid         Float?
  ask         Float?
  active      Boolean  @default(true)
  note        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/** CRM: employee/manager contact notes with clients */
model ContactLog {
  id        String   @id @default(cuid())
  clientId  String
  staffId   String
  note      String
  channel   String   @default("phone")
  client    User     @relation("ContactClient", fields: [clientId], references: [id], onDelete: Cascade)
  staff     User     @relation("ContactStaff", fields: [staffId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([staffId])
}

/** CRM internal comments */
model CrmComment {
  id          String   @id @default(cuid())
  body        String
  attachment  String?
  clientId    String
  staffId     String
  client      User     @relation("CrmCommentClient", fields: [clientId], references: [id], onDelete: Cascade)
  staff       User     @relation("CrmCommentStaff", fields: [staffId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

/** CRM activity / audit log */
model CrmActivity {
  id        String   @id @default(cuid())
  action    String
  detail    String?
  ip        String?
  device    String?
  clientId  String
  staffId   String?
  client    User     @relation("CrmActivityClient", fields: [clientId], references: [id], onDelete: Cascade)
  staff     User?    @relation("CrmActivityStaff", fields: [staffId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([createdAt])
}

/** CRM staff inbox notifications */
model StaffNotification {
  id          String   @id @default(cuid())
  type        String
  title       String
  body        String
  clientId    String?
  recipientId String?
  recipient   User?    @relation("StaffNotifRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId, read])
  @@index([createdAt])
  @@index([type])
}

/** Security: login attempts / history */
model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  ip        String?
  device    String?
  success   Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([ip])
}

/** Security: active staff sessions */
model StaffSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String
  ip           String?
  device       String?
  lastActiveAt DateTime @default(now())
  revoked      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, revoked])
  @@index([tokenHash])
}

/** Per-country bank transfer details (managed from admin panel) */
model BankAccount {
  id            String   @id @default(cuid())
  countryCode   String   @unique
  label         String
  bankName      String   @default("")
  accountName   String   @default("")
  iban          String   @default("")
  swift         String   @default("")
  referenceHint String?
  contactOnly   Boolean  @default(false)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
